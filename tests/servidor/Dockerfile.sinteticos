# Ferramentas públicas, Helm fixado e dependências de produção sem build da aplicação.
# O contexto contém somente esta receita e package/lock/workspace públicos projetados.
FROM alpine/helm:latest@sha256:e3f8d5c462d75470fbb1fce79ad5c20063657096d1f98c0fcea869e2600e2e5e AS helm
FROM node:24.22.2-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9 AS dependencias
WORKDIR /opt/ensaio
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && corepack pnpm install --frozen-lockfile --prod --ignore-scripts
FROM node:24.22.2-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash coreutils util-linux jq git openssl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=helm /usr/bin/helm /usr/local/bin/helm
COPY --from=dependencias /opt/ensaio/node_modules /node_modules
LABEL frequenciapp.ensaio.toolchain="sinteticos-v2"
ENV HOME=/tmp TMPDIR=/tmp GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_ALLOW_PROTOCOL=file HELM_BIN=/usr/local/bin/helm
WORKDIR /repo
USER 1000:1000
ENTRYPOINT []
CMD ["node"]
