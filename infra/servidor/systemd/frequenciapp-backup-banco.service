[Unit]
Description=Backup do banco do FrequenciApp
Documentation=https://github.com/eemtijca/frequenciapp/blob/main/docs/auto-hospedagem.md
OnFailure=frequenciapp-falha@%n
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=@USUARIO@
Group=@USUARIO@
WorkingDirectory=@APP_DIR@
Environment=SERVIDOR_AMBIENTE_INJETADO=true
EnvironmentFile=-@CONFIG_DIR@/app.env
EnvironmentFile=-@CONFIG_DIR@/ops.env
Environment=NOTIFICAR_URL=
Environment=APP_DIR=@APP_DIR@
Environment=APP_ENV_FILE=@CONFIG_DIR@/app.env
Environment=OPS_ENV_FILE=@CONFIG_DIR@/ops.env
Environment=ESTADO_DIR=@ESTADO_DIR@
Environment=LOG_DIR=@LOG_DIR@
Environment=BACKUP_DIR=@BACKUP_DIR@
Environment=SERVIDOR_LOCK_DIR=@LOCK_DIR@
ExecStart=/bin/bash @APP_DIR@/scripts/servidor/backup-banco.sh
TimeoutStartSec=1h
UMask=0077
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ReadWritePaths=@ESTADO_DIR@ @LOG_DIR@ @BACKUP_DIR@ @CONFIG_DIR@ @LOCK_DIR@
