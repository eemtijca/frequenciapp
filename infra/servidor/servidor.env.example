# Exemplo de /etc/frequenciapp/ops.env para servidor auto-hospedado.
# Copie para um arquivo privado com permissão 600 e preencha os valores.
# Não coloque segredos neste repositório.

# Proxy e TLS.
PROXY_TIPO=caddy
TLS_MODO=acme
DOMINIO=frequencia.exemplo.br
ACME_EMAIL=administracao@escola.exemplo.br
ACME_CA=https://acme-v02.api.letsencrypt.org/directory
PROXY_HTTP_PORTA=80
PROXY_HTTPS_PORTA=443
CADDYFILE=infra/servidor/Caddyfile
CERTBOT_CERTS_DIR=./infra/servidor/nginx/certificados

# Caminhos.
APP_DIR=/opt/frequenciapp
APP_ENV_FILE=/etc/frequenciapp/app.env
OPS_ENV_FILE=/etc/frequenciapp/ops.env
SERVIDOR_CONFIG_DIR=/etc/frequenciapp
ESTADO_DIR=/var/lib/frequenciapp
LOG_DIR=/var/log/frequenciapp
BACKUP_DIR=/var/backups/frequenciapp
BACKUP_BANCO_DIR=/var/backups/frequenciapp/banco
BACKUP_PLANILHAS_DIR=/var/backups/frequenciapp/planilhas
SERVIDOR_USUARIO=frequenciapp

# Backup do banco.
BACKUP_MODO=compose
BACKUP_CRIPTOGRAFIA=gpg
BACKUP_GPG_DESTINATARIO=backup@escola.exemplo.br
BACKUP_GPG_CHAVE_PUBLICA=/etc/frequenciapp/backup-publica.asc
# BACKUP_AGE_DESTINATARIOS=/etc/frequenciapp/age-destinatarios.txt
BACKUP_RCLONE_CONFIG=/etc/frequenciapp/rclone.conf
BACKUP_REMOTO=destino:frequenciapp/banco
BACKUP_VERIFICAR_REMOTO=true
BACKUP_RETER_DIAS=30
BACKUP_ESPACO_MINIMO_MB=512
BACKUP_INCLUIR_AMBIENTE=true
BACKUP_AMBIENTE_ARQUIVO=/etc/frequenciapp/app.env

# Backup das planilhas.
BACKUP_PLANILHAS_HABILITADO=true
BACKUP_PLANILHAS_LOCAL=true
BACKUP_ORIGEM=origem:planilhas
BACKUP_DESTINO=destino:frequenciapp/planilhas
BACKUP_CHAVE=troque-por-uma-chave-de-32-a-256-caracteres

# Atualização.
ATUALIZAR_MODO=auto
ATUALIZAR_REF=origin/main
ATUALIZAR_REMOTO=origin
ATUALIZAR_BACKUP_ANTES=true
ATUALIZAR_PERMITIR_MIGRACOES=false
ATUALIZAR_SAUDE_URL=https://frequencia.exemplo.br/api/saude
ATUALIZAR_TIMEOUT_SAUDE=180
ATUALIZAR_ESPACO_MINIMO_MB=2048
APP_IMAGEM_REPOSITORIO=ghcr.io/eemtijca/frequenciapp
APP_IMAGEM_BACKUP_REPOSITORIO=ghcr.io/eemtijca/frequenciapp-backup

# Agenda e cron.
AGENDA_HABILITADA=true
AGENDA_URL=http://127.0.0.1:3000
AGENDA_TIMEOUT=300
AGENDA_HORARIO=*/5 * * * *
BACKUP_HORARIO=30 2 * * *
BACKUP_PLANILHAS_HORARIO=0 3 * * *
ATUALIZAR_HORARIO=30 4 * * *
CERTBOT_RENOVAR_HORARIO=15 2 * * *
MAILTO=administracao@escola.exemplo.br

# Opcional: webhook de sucesso ou falha, sem dados escolares.
# NOTIFICAR_URL=https://monitor.exemplo.br/frequenciapp
