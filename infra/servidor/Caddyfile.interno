# Caddy interno do FrequenciApp: CA local, HTTPS e proxy para a aplicação.
{
	admin off
	persist_config off
	grace_period 10s
}

{$DOMINIO} {
	tls internal
	encode zstd gzip

	reverse_proxy app:3000 {
		health_uri /api/saude
		health_interval 30s
		health_timeout 5s
	}

	header -Server

	log {
		output stdout
		format json
	}
}
