# Caddy público do FrequenciApp: ACME, HTTPS e proxy para a aplicação.
{
	email {$ACME_EMAIL}
	acme_ca {$ACME_CA}
	admin off
	persist_config off
	grace_period 10s
	log {
		format filter {
			wrap json
			fields {
				request>uri query {
					delete code
					delete state
				}
			}
		}
	}
}

{$DOMINIO} {
	encode zstd gzip

	reverse_proxy app:3000 {
		health_uri /api/saude
		health_interval 30s
		health_timeout 5s
	}

	header -Server

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete code
					delete state
				}
			}
		}
	}
}
