{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "fix/instalador-preserva-rotinas": false,
      "chore/atualizacoes-consolidadas": false
    }
  },
  "buildCommand": "pnpm run vercel-build",
  "installCommand": "NODE_ENV=development pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "cleanUrls": true
}
