# FrequenciApp. Variáveis de ambiente.
# Copie para .env no desenvolvimento local ou preencha o projeto na Vercel.
# Com Docker Compose, defina AUTH_SECRET e, para OAuth, as variáveis Google.
# Nunca faça commit do .env com valores reais.

# Conexão usada pelo runtime da API e pelo Prisma Client.
# No Docker Compose deste repositório, este valor é para comandos no host.
DATABASE_URL=postgresql://frequencia:frequencia@localhost:5432/frequencia

# Conexão usada pelo Prisma CLI, pelo migrador e pelos scripts administrativos.
# Em produção no Supabase, use a Session pooler aqui.
# No Docker Compose local, use a mesma URL acima.
DIRECT_URL=postgresql://frequencia:frequencia@localhost:5432/frequencia

# Exemplo para a Vercel com Supabase:
# DATABASE_URL deve usar a Transaction pooler, porta 6543 e pgbouncer=true.
# Copie o host e o usuário exatamente como mostrado no painel do Supabase.
# DATABASE_URL=postgresql://USUARIO.PROJECT_REF:SENHA@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require
# DIRECT_URL deve usar a Session pooler, porta 5432, sem pgbouncer=true.
# DIRECT_URL=postgresql://USUARIO.PROJECT_REF:SENHA@POOLER_HOST:5432/postgres?sslmode=require
# Codifique a senha antes de colocá-la na URL.
# Preview no mesmo banco: acrescente &schema=preview nas duas URLs do escopo Preview.
# Sem schema explícito, o padrão é public. O schema deve existir e ter migrações aplicadas.
# USUARIO é uma role PostgreSQL existente, não o nome do schema. Veja docs/deploy.md.
# DATABASE_SCHEMA, quando definida, escolhe o schema sem alterar as URLs e vence o
# parâmetro schema delas. É o botão usado por plataformas que variam o schema por
# ambiente, sem reescrever a connection string.
# DATABASE_SCHEMA=preview

# Segredo das sessões. Gere um valor aleatório com:
#   openssl rand -base64 32
AUTH_SECRET=troque-este-segredo-por-um-aleatorio-de-32-bytes

# Notificações Web Push: sem estas variáveis, o par é derivado de AUTH_SECRET.
# Para manter um par próprio, gere com `npx web-push generate-vapid-keys`
# e configure as duas chaves juntas. A chave privada fica somente no servidor.
# O contato é opcional, em mailto: ou HTTPS; pode ser definido sem as chaves.
# PUSH_VAPID_PUBLIC_KEY=chave-publica-do-par-vapid
# PUSH_VAPID_PRIVATE_KEY=chave-privada-do-par-vapid
# PUSH_VAPID_SUBJECT=mailto:administracao@escola.br
# Agenda de avisos diários. Gere outro segredo com openssl rand -base64 32.
# Na Vercel, CRON_SECRET é enviado como Bearer nas chamadas da agenda.
# CRON_SECRET=segredo-da-agenda-com-pelo-menos-32-caracteres

# OAuth do Google para a planilha de frequência. Configure as cinco variáveis
# juntas. Restrinja a chave do Picker ao domínio do aplicativo e a
# https://docs.google.com/* no Google Cloud.
# GOOGLE_CLIENT_ID=identificador-do-cliente.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=segredo-do-cliente
# GOOGLE_REDIRECT_URI=https://app.exemplo.br/api/planilha/google/retorno
# GOOGLE_PICKER_API_KEY=chave-publica-restrita-ao-dominio
# GOOGLE_PROJECT_NUMBER=123456789012

# Fuso usado para resolver o dia corrente e os rótulos de datas.
TZ_APP=America/Fortaleza

# Aceita implantação sem TLS (VPS em rede confiável). Padrão: false.
# Com true, o cookie de sessão não usa Secure, o HSTS não é enviado e o CSP
# não força upgrade para HTTPS. Sem TLS o tráfego fica em texto puro e o PWA
# não instala nem funciona offline fora de localhost. Em produção com proxy
# TLS, mantenha false.
# PERMITIR_HTTP=false

# Criação do administrador inicial. Com Docker Compose, preencha as três
# variáveis: o entrypoint cria o admin na partida, mas não altera uma conta
# que já exista (a senha não é regravada a cada reinício). Sem Docker, rode
# `npm run criar-admin`, que cria ou atualiza a conta.
# ADMIN_EMAIL=direcao@escola.br
# ADMIN_SENHA=uma-senha-forte
# ADMIN_NOME=Direção

# Criação de uma conta de coordenação pelo comando `npm run criar-coordenacao`.
# CONTA_EMAIL=equipe@escola.br
# CONTA_SENHA=uma-senha-forte
# CONTA_NOME=Equipe

# Semente opcional de desenvolvimento, com séries, turmas e alunos sintéticos.
# SEED_ALUNOS=12
