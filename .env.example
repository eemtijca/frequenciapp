# FrequenciApp. Variáveis de ambiente.
# Copie para .env (desenvolvimento local) ou preencha no provedor de deploy.
# Nunca faça commit do .env com valores reais.

# Conexão com o PostgreSQL 17, por connection string.
# Formato: postgresql://usuario:senha@host:porta/banco
# Com o Docker Compose deste repositório, use o valor padrão abaixo.
DATABASE_URL=postgresql://chamada:chamada@localhost:5432/chamada

# Segredo das sessões (assinatura dos tokens). Gere com:
#   openssl rand -base64 32
AUTH_SECRET=troque-este-segredo-por-um-aleatorio-de-32-bytes

# Fuso horário usado para resolver o dia corrente (padrão America/Fortaleza).
TZ_APP=America/Fortaleza

# Criação do administrador inicial pelo comando `npm run criar-admin`.
# O admin é o primeiro usuário, com acesso root de configuração.
# Preencha apenas quando for criar o admin; o comando é idempotente.
# ADMIN_EMAIL=direcao@escola.br
# ADMIN_SENHA=uma-senha-forte
# ADMIN_NOME=Direção

# Criação de conta de professor (demonstração e testes) pelo comando
# `npm run criar-conta`. O gerenciamento do dia a dia é feito pelo admin.
# CONTA_EMAIL=professor@escola.br
# CONTA_SENHA=uma-senha-forte
# CONTA_NOME=Professor(a)

# Semente de desenvolvimento (séries, turmas e alunos sintéticos).
# SEED_ALUNOS=12
