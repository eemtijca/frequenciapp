# FrequenciApp. Variáveis de ambiente.
# Copie para .env no desenvolvimento local ou preencha o projeto na Vercel.
# Com Docker Compose, defina apenas AUTH_SECRET; o restante segue o compose.yml.
# Nunca faça commit do .env com valores reais.

# Conexão usada pelo runtime da API e pelo Prisma Client.
# No Docker Compose deste repositório, este valor é para comandos no host.
DATABASE_URL=postgresql://frequencia:frequencia@localhost:5432/frequencia

# Conexão usada pelo Prisma CLI, pelo migrador e pelos scripts administrativos.
# Em produção no Supabase, use a Session pooler aqui.
# No Docker Compose local, use a mesma URL acima.
DIRECT_URL=postgresql://frequencia:frequencia@localhost:5432/frequencia

# Exemplo para a Vercel com Supabase:
# DATABASE_URL deve usar a Transaction pooler, porta 6543 e pgbouncer=true.
# Copie o host e o usuário exatamente como mostrado no painel do Supabase.
# DATABASE_URL=postgresql://prisma.PROJECT_REF:SENHA@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require
# DIRECT_URL deve usar a Session pooler, porta 5432, sem pgbouncer=true.
# DIRECT_URL=postgresql://prisma.PROJECT_REF:SENHA@POOLER_HOST:5432/postgres?sslmode=require
# Codifique a senha antes de colocá-la na URL.

# Segredo das sessões. Gere um valor aleatório com:
#   openssl rand -base64 32
AUTH_SECRET=troque-este-segredo-por-um-aleatorio-de-32-bytes

# Fuso usado para resolver o dia corrente e os rótulos de datas.
TZ_APP=America/Fortaleza

# Aceita implantação sem TLS (VPS em rede confiável). Padrão: false.
# Com true, o cookie de sessão não usa Secure, o HSTS não é enviado e o CSP
# não força upgrade para HTTPS. Sem TLS o tráfego fica em texto puro e o PWA
# não instala nem funciona offline fora de localhost. Em produção com proxy
# TLS, mantenha false.
# PERMITIR_HTTP=false

# Aceita endpoint local (http://127.0.0.1 ou http://localhost) na integração
# com Google Planilhas mesmo em produção. Apenas para testes e ambientes
# controlados: o padrão restringe o endereço a script.google.com. Padrão: false.
# PERMITIR_ENDPOINT_LOCAL=false

# Criação do administrador inicial. Com Docker Compose, preencha as três
# variáveis: o entrypoint cria o admin na partida, mas não altera uma conta
# que já exista (a senha não é regravada a cada reinício). Sem Docker, rode
# `npm run criar-admin`, que cria ou atualiza a conta.
# ADMIN_EMAIL=direcao@escola.br
# ADMIN_SENHA=uma-senha-forte
# ADMIN_NOME=Direção

# Criação de uma conta de coordenação pelo comando `npm run criar-coordenacao`.
# CONTA_EMAIL=equipe@escola.br
# CONTA_SENHA=uma-senha-forte
# CONTA_NOME=Equipe

# Semente opcional de desenvolvimento, com séries, turmas e alunos sintéticos.
# SEED_ALUNOS=12
