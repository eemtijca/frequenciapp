// Esquema do banco, fonte da verdade do Prisma Client. A frequência é única
// por turma e dia, compartilhada pela coordenação, e cada falta guarda a aula.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Papel do usuário. ADMIN cuida de contas e cadastros; COORDENACAO faz a
// frequência, consulta o histórico e a grade do mês; DIRETOR_TURMA só lê as
// estatísticas das turmas do seu vínculo (ADR-021).
enum Papel {
  ADMIN
  COORDENACAO
  DIRETOR_TURMA

  @@map("papel")
}

// Tipos de aviso com confirmações independentes por dispositivo.
enum TipoNotificacao {
  RESUMO_DIARIO
  NOVA_CHAMADA
  CHAMADAS_PENDENTES

  @@map("tipo_notificacao")
}

// Modo de escrita na planilha: conservador preenche apenas célula vazia;
// completo permite substituir, limpar e remover o que a integração criou.
enum ModoPlanilha {
  CONSERVADOR
  COMPLETO

  @@map("modo_planilha")
}

// Finalidade da integração com a planilha: a frequência das turmas de origem
// ou os registros de saídas e chamada parcial em arquivos próprios.
enum FinalidadeIntegracao {
  FREQUENCIA
  SAIDAS
  PARCIAL

  @@map("finalidade_integracao")
}

// Forma de representar a presença parcial sem alterar a chamada regular.
enum TipoFrequenciaParcial {
  TURNO
  AULAS

  @@map("tipo_frequencia_parcial")
}

// Turno integral escolhido explicitamente para o registro parcial.
enum TurnoParcial {
  MANHA
  TARDE

  @@map("turno_parcial")
}

// Modalidade registrada em cada sincronização concluída.
enum ModalidadeSincronizacao {
  CONSERVADOR
  COMPLETO

  @@map("modalidade_sincronizacao")
}

// Resultado de uma sincronização: total, parcial ou falha.
enum ResultadoSincronizacao {
  SUCESSO
  PARCIAL
  FALHA

  @@map("resultado_sincronizacao")
}

// Usuário da aplicação. Sem dados além do necessário: nome de
// tratamento, e-mail para acesso, hash da senha e papel.
model Usuario {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String
  senhaHash                String                     @map("senha_hash")
  nome                     String
  papel                    Papel                      @default(COORDENACAO)
  ativo                    Boolean                    @default(true)
  criadoEm                 DateTime                   @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm             DateTime                   @updatedAt @map("atualizado_em") @db.Timestamptz
  sessoes                  Sessao[]
  frequenciasCriadas       Frequencia[]               @relation("FrequenciaCriadaPor")
  frequenciasAtualizadas   Frequencia[]               @relation("FrequenciaAtualizadaPor")
  saidasLiberadas          SaidaAntecipada[]          @relation("SaidaLiberadaPor")
  saidasCriadas            SaidaAntecipada[]          @relation("SaidaCriadaPor")
  entradasCriadas          EntradaAtrasada[]
  parciaisCriadas          FrequenciaParcial[]        @relation("ParcialCriadaPor")
  parciaisAtualizadas      FrequenciaParcial[]        @relation("ParcialAtualizadaPor")
  parciaisConfirmadas      FrequenciaParcial[]        @relation("ParcialConfirmadaPor")
  chamadasConfirmadas      AlunoDaChamada[]           @relation("ChamadaConfirmadaPor")
  configuracoesAtualizadas Configuracao[]             @relation("ConfiguracaoAtualizadaPor")
  integracoesModo          IntegracaoPlanilha[]       @relation("IntegracaoModoPor")
  integracoesAtualizadas   IntegracaoPlanilha[]       @relation("IntegracaoAtualizadaPor")
  sincronizacoesPlanilha   SincronizacaoPlanilha[]    @relation("SincronizacaoCriadaPor")
  auditorias               Auditoria[]
  vinculosDiretor          VinculoDiretor[]           @relation("VinculoDoDiretor")
  vinculosCriados          VinculoDiretor[]           @relation("VinculoCriadoPor")
  credencialDiretor        CredencialDiretor?
  parametrosAtualizados    ParametrosAcesso[]         @relation("ParametrosAtualizadosPor")
  assinaturasPush          AssinaturaPush[]
  preferenciaNotificacoes  PreferenciaNotificacoes?
  notificacoesAtualizadas  ConfiguracaoNotificacoes[] @relation("NotificacoesAtualizadasPor")

  @@index([papel])
  @@map("usuarios")
}

// Sessão opaca: o token trafega em cookie HttpOnly apenas como hash.
model Sessao {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash       String           @unique @map("token_hash")
  usuarioId       String           @map("usuario_id") @db.Uuid
  criadoEm        DateTime         @default(now()) @map("criado_em") @db.Timestamptz
  expiraEm        DateTime         @map("expira_em") @db.Timestamptz
  usuario         Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  assinaturasPush AssinaturaPush[]

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes")
}

// Assinatura voluntária de um dispositivo. A sessão identifica a saída
// explícita; sua expiração não encerra a preferência de notificações.
model AssinaturaPush {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId    String        @map("usuario_id") @db.Uuid
  sessaoId     String?       @map("sessao_id") @db.Uuid
  endpoint     String        @unique @db.VarChar(2048)
  p256dh       String        @db.VarChar(87)
  auth         String        @db.VarChar(22)
  chaveVapid   String        @map("chave_vapid") @db.VarChar(87)
  testadoEm    DateTime?     @map("testado_em") @db.Timestamptz
  criadoEm     DateTime      @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz
  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sessao       Sessao?       @relation(fields: [sessaoId], references: [id], onDelete: SetNull)
  entregas     EntregaPush[]

  @@index([usuarioId])
  @@index([sessaoId])
  @@map("assinaturas_push")
}

// Um aviso diário por assinatura, com reserva para envios concorrentes
// e confirmação somente depois da aceitação pelo serviço de push.
model EntregaPush {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assinaturaId String          @map("assinatura_id") @db.Uuid
  dia          DateTime        @db.Date
  tipo         TipoNotificacao @default(RESUMO_DIARIO)
  referencia   String          @default("") @db.VarChar(36)
  reservadaEm  DateTime?       @map("reservada_em") @db.Timestamptz
  enviadaEm    DateTime?       @map("enviada_em") @db.Timestamptz
  criadoEm     DateTime        @default(now()) @map("criado_em") @db.Timestamptz
  assinatura   AssinaturaPush  @relation(fields: [assinaturaId], references: [id], onDelete: Cascade)

  @@unique([assinaturaId, dia, tipo, referencia])
  @@index([dia])
  @@map("entregas_push")
}

// Escolhas pessoais valem para todos os dispositivos da conta. Sem linha,
// os padrões preservam o resumo existente e exigem adesão a novas chamadas.
model PreferenciaNotificacoes {
  usuarioId          String    @id @map("usuario_id") @db.Uuid
  resumoDiario       Boolean   @default(true) @map("resumo_diario")
  novasChamadas      Boolean   @default(false) @map("novas_chamadas")
  chamadasPendentes  Boolean   @default(true) @map("chamadas_pendentes")
  novasChamadasDesde DateTime? @map("novas_chamadas_desde") @db.Timestamptz
  atualizadoEm       DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz
  usuario            Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("preferencias_notificacoes")
}

// Regras da escola, alteradas pela Gestão e avaliadas no fuso da instalação.
model ConfiguracaoNotificacoes {
  id                String   @id @default("principal")
  resumoDiario      Boolean  @default(true) @map("resumo_diario")
  novasChamadas     Boolean  @default(true) @map("novas_chamadas")
  chamadasPendentes Boolean  @default(false) @map("chamadas_pendentes")
  horarioResumo     String   @default("17:00") @map("horario_resumo") @db.VarChar(5)
  horarioPendencias String   @default("17:00") @map("horario_pendencias") @db.VarChar(5)
  atualizadoEm      DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  atualizadoPorId   String?  @map("atualizado_por_id") @db.Uuid
  atualizadoPor     Usuario? @relation("NotificacoesAtualizadasPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("configuracoes_notificacoes")
}

// Série escolar (por exemplo, "1º ano"). Referência para as turmas.
model Serie {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                String
  ordem               Int
  criadoEm            DateTime                  @default(now()) @map("criado_em") @db.Timestamptz
  turmas              Turma[]
  configuracoesOrigem ConfiguracaoOrigemSerie[]

  @@index([ordem])
  @@map("series")
}

// Turma de uma série (por exemplo, "1º ano A"). A exclusão é barrada
// enquanto houver alunos ou frequências vinculadas.
model Turma {
  id                  String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serieId             String                  @map("serie_id") @db.Uuid
  nome                String
  criadoEm            DateTime                @default(now()) @map("criado_em") @db.Timestamptz
  serie               Serie                   @relation(fields: [serieId], references: [id], onDelete: Restrict)
  alunos              Aluno[]                 @relation("AlunoTurma")
  origemDe            Aluno[]                 @relation("AlunoTurmaOriginal")
  frequencias         Frequencia[]
  horarios            Horario[]
  sincronizacoes      SincronizacaoPlanilha[] @relation("SincronizacaoTurma")
  entradas            EntradaAtrasada[]
  frequenciasParciais FrequenciaParcial[]

  vinculosDiretor     VinculoDiretor[]          @relation("VinculoDaTurma")
  configuracoesOrigem ConfiguracaoOrigemTurma[]

  @@unique([serieId, nome])
  @@map("turmas")
}

// Aluno de uma turma. Nome do aluno, turma atual (de onde parte a
// frequência diária) e turma original (referência de origem para a
// consulta agrupada). Nenhum outro dado pessoal é armazenado.
model Aluno {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turmaId              String              @map("turma_id") @db.Uuid
  turmaOriginalId      String              @map("turma_original_id") @db.Uuid
  nome                 String
  ordem                Int
  ativo                Boolean             @default(true)
  desistenteEm         DateTime?           @map("desistente_em") @db.Date
  situacaoAtualizadaEm DateTime?           @map("situacao_atualizada_em") @db.Timestamptz
  criadoEm             DateTime            @default(now()) @map("criado_em") @db.Timestamptz
  turma                Turma               @relation("AlunoTurma", fields: [turmaId], references: [id], onDelete: Restrict)
  turmaOriginal        Turma               @relation("AlunoTurmaOriginal", fields: [turmaOriginalId], references: [id], onDelete: Restrict)
  faltas               Falta[]
  saidas               SaidaAntecipada[]
  entradas             EntradaAtrasada[]
  frequenciasParciais  FrequenciaParcial[]
  chamadas             AlunoDaChamada[]

  @@index([turmaId, ordem])
  @@index([turmaOriginalId])
  @@map("alunos")
}

// Aula da turma: ordem, janela de horário e dias da semana em que acontece.
// A aula padrão cobre o dia inteiro para nenhuma turma ficar sem chamada.
model Horario {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turmaId    String   @map("turma_id") @db.Uuid
  ordem      Int
  inicio     String   @db.VarChar(5)
  fim        String   @db.VarChar(5)
  diasSemana Int[]    @map("dias_semana")
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz
  turma      Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  faltas     Falta[]

  @@unique([turmaId, ordem])
  @@index([turmaId])
  @@map("horarios")
}

// Frequência de um dia e turma, compartilhada pela coordenação. revisao 1 no
// primeiro salvamento e crescimento a cada atualização bem-sucedida; a autoria
// fica anulável para o histórico não depender da conta.
model Frequencia {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turmaId         String           @map("turma_id") @db.Uuid
  dia             DateTime         @db.Date
  revisao         Int              @default(1)
  criadoEm        DateTime         @default(now()) @map("criado_em") @db.Timestamptz
  criadoPorId     String?          @map("criado_por_id") @db.Uuid
  atualizadoPorId String?          @map("atualizado_por_id") @db.Uuid
  atualizadoEm    DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz
  turma           Turma            @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  criadoPor       Usuario?         @relation("FrequenciaCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  atualizadoPor   Usuario?         @relation("FrequenciaAtualizadaPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)
  faltas          Falta[]
  alunos          AlunoDaChamada[]

  @@unique([turmaId, dia])
  @@index([dia])
  @@map("frequencias")
}

// Presença parcial por aluno e dia, com retrato da turma e confirmação manual
// de lançamento na Seduc. Revisão protege correções e confirmações concorrentes.
model FrequenciaParcial {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alunoId                String                @map("aluno_id") @db.Uuid
  dia                    DateTime              @db.Date
  turmaId                String                @map("turma_id") @db.Uuid
  alunoNome              String                @map("aluno_nome") @db.VarChar(200)
  turmaNome              String                @map("turma_nome") @db.VarChar(200)
  tipo                   TipoFrequenciaParcial
  turno                  TurnoParcial?
  aulas                  Int[]
  observacao             String?               @db.VarChar(300)
  registradoSeduc        Boolean               @default(false) @map("registrado_seduc")
  registradoSeducEm      DateTime?             @map("registrado_seduc_em") @db.Timestamptz
  registradoSeducPorId   String?               @map("registrado_seduc_por_id") @db.Uuid
  registradoSeducPorNome String?               @map("registrado_seduc_por_nome") @db.VarChar(200)
  revisao                Int                   @default(1)
  criadoPorId            String?               @map("criado_por_id") @db.Uuid
  atualizadoPorId        String?               @map("atualizado_por_id") @db.Uuid
  criadoEm               DateTime              @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm           DateTime              @updatedAt @map("atualizado_em") @db.Timestamptz
  aluno                  Aluno                 @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma                  Turma                 @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  criadoPor              Usuario?              @relation("ParcialCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  atualizadoPor          Usuario?              @relation("ParcialAtualizadaPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)
  registradoSeducPor     Usuario?              @relation("ParcialConfirmadaPor", fields: [registradoSeducPorId], references: [id], onDelete: SetNull)

  @@unique([alunoId, dia])
  @@index([turmaId, dia])
  @@index([dia, registradoSeduc])
  @@map("frequencias_parciais")
}

// Quem estava na lista da chamada, presente ou ausente. Fixa o histórico:
// mover o aluno de turma depois não muda a presença dos dias já salvos.
model AlunoDaChamada {
  frequenciaId           String     @map("frequencia_id") @db.Uuid
  alunoId                String     @map("aluno_id") @db.Uuid
  registradoSeduc        Boolean    @default(false) @map("registrado_seduc")
  registradoSeducEm      DateTime?  @map("registrado_seduc_em") @db.Timestamptz
  registradoSeducPorId   String?    @map("registrado_seduc_por_id") @db.Uuid
  registradoSeducPorNome String?    @map("registrado_seduc_por_nome") @db.VarChar(200)
  revisaoSeduc           Int        @default(0) @map("revisao_seduc")
  registradoSeducPor     Usuario?   @relation("ChamadaConfirmadaPor", fields: [registradoSeducPorId], references: [id], onDelete: SetNull)
  frequencia             Frequencia @relation(fields: [frequenciaId], references: [id], onDelete: Cascade)
  aluno                  Aluno      @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@id([frequenciaId, alunoId])
  @@index([alunoId])
  @@map("alunos_chamada")
}

// Falta de um aluno em uma aula da frequência. Presença não gera linha. A
// justificativa é o código do catálogo e vale para a falta e para a saída.
model Falta {
  frequenciaId  String     @map("frequencia_id") @db.Uuid
  alunoId       String     @map("aluno_id") @db.Uuid
  horarioId     String     @map("horario_id") @db.Uuid
  justificativa String?    @db.VarChar(10)
  observacao    String?    @db.VarChar(200)
  frequencia    Frequencia @relation(fields: [frequenciaId], references: [id], onDelete: Cascade)
  aluno         Aluno      @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  horario       Horario    @relation(fields: [horarioId], references: [id], onDelete: Restrict)

  @@id([frequenciaId, alunoId, horarioId])
  @@index([alunoId])
  @@index([horarioId])
  @@map("faltas")
}

// Saída antecipada registrada pela direção ou coordenação. É separada da
// chamada: a presença ou falta do dia permanece como foi marcada. A
// justificativa é um código do catálogo ou, quando nula, o texto livre.
// Quem libera é um código do catálogo de liberadores; a conta antiga fica em
// liberadoPor.
model SaidaAntecipada {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alunoId           String   @map("aluno_id") @db.Uuid
  dia               DateTime @db.Date
  momento           String   @db.VarChar(20)
  // HH:MM em que o aluno saiu; anulável para registros anteriores ao campo.
  horario           String?  @db.VarChar(5)
  justificativa     String?  @db.VarChar(10)
  observacao        String?  @db.VarChar(200)
  texto             String?  @db.VarChar(100)
  liberadoPorId     String?  @map("liberado_por_id") @db.Uuid
  liberadoPorCodigo String?  @map("liberado_por_codigo") @db.VarChar(20)
  criadoPorId       String?  @map("criado_por_id") @db.Uuid
  criadoEm          DateTime @default(now()) @map("criado_em") @db.Timestamptz
  aluno             Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  liberadoPor       Usuario? @relation("SaidaLiberadaPor", fields: [liberadoPorId], references: [id], onDelete: SetNull)
  criadoPor         Usuario? @relation("SaidaCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@unique([alunoId, dia])
  @@index([dia])
  @@index([alunoId, dia])
  @@map("saidas_antecipadas")
}

// Chegada atrasada independente da chamada, com turma e autoria históricas.
model EntradaAtrasada {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alunoId                   String   @map("aluno_id") @db.Uuid
  turmaId                   String   @map("turma_id") @db.Uuid
  turmaRotulo               String   @map("turma_rotulo") @db.VarChar(100)
  dia                       DateTime @db.Date
  horario                   String   @db.VarChar(5)
  motivo                    String   @db.VarChar(200)
  registradoPorNome         String   @map("registrado_por_nome") @db.VarChar(100)
  momento                   String?  @db.VarChar(20)
  responsavelRegistroCodigo String?  @map("responsavel_registro_codigo") @db.VarChar(20)
  responsavelRegistroNome   String?  @map("responsavel_registro_nome") @db.VarChar(100)
  criadoPorId               String?  @map("criado_por_id") @db.Uuid
  criadoEm                  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  aluno                     Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma                     Turma    @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  criadoPor                 Usuario? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@unique([alunoId, dia])
  @@index([dia, turmaId])
  @@map("entradas_atrasadas")
}

// Vínculo de um diretor com uma turma de origem, com período. O fim é
// registrado e nunca apagado, para o histórico dizer quem via o quê.
model VinculoDiretor {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  turmaId     String    @map("turma_id") @db.Uuid
  inicio      DateTime  @db.Date
  fim         DateTime? @db.Date
  criadoPorId String?   @map("criado_por_id") @db.Uuid
  criadoEm    DateTime  @default(now()) @map("criado_em") @db.Timestamptz
  usuario     Usuario   @relation("VinculoDoDiretor", fields: [usuarioId], references: [id], onDelete: Cascade)
  turma       Turma     @relation("VinculoDaTurma", fields: [turmaId], references: [id], onDelete: Restrict)
  criadoPor   Usuario?  @relation("VinculoCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([turmaId])
  @@map("vinculos_diretor")
}

// Palavra-chave do diretor: o segredo é a senha da conta (scrypt); aqui fica
// o ciclo de vida, com emissão, validade, primeiro uso e revogação.
model CredencialDiretor {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId        String    @unique @map("usuario_id") @db.Uuid
  emitidaEm        DateTime  @map("emitida_em") @db.Timestamptz
  expiraEm         DateTime  @map("expira_em") @db.Timestamptz
  primeiroUsoEm    DateTime? @map("primeiro_uso_em") @db.Timestamptz
  revogadaEm       DateTime? @map("revogada_em") @db.Timestamptz
  motivoRevogacao  String?   @map("motivo_revogacao") @db.VarChar(200)
  trocaObrigatoria Boolean   @default(true) @map("troca_obrigatoria")
  atualizadoEm     DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("credenciais_diretor")
}

// Tentativas de entrada por chave, em janela deslizante. Fica no banco para
// valer entre instâncias; a chave é natural e a linha vence com a janela.
model TentativaEntrada {
  chave        String   @id @db.VarChar(300)
  contagem     Int
  janelaInicio DateTime @map("janela_inicio") @db.Timestamptz

  @@index([janelaInicio])
  @@map("tentativas_entrada")
}

// Parâmetros de acesso editáveis pela administração: validade da palavra-chave,
// sessão do diretor, limites de tentativa, o que o diretor vê e o limite de
// risco. Linha única; faixas conferidas no banco.
model ParametrosAcesso {
  id                    String   @id @default("principal")
  validadePalavraDias   Int      @default(90) @map("validade_palavra_dias")
  sessaoDiretorHoras    Int      @default(12) @map("sessao_diretor_horas")
  tentativasPorOrigem   Int      @default(10) @map("tentativas_por_origem")
  tentativasPorLogin    Int      @default(30) @map("tentativas_por_login")
  janelaMinutos         Int      @default(15) @map("janela_minutos")
  categoriasDiretor     String[] @default(["faltas"]) @map("categorias_diretor")
  limiteRiscoPercentual Int      @default(25) @map("limite_risco_percentual")
  atualizadoEm          DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  atualizadoPorId       String?  @map("atualizado_por_id") @db.Uuid
  atualizadoPor         Usuario? @relation("ParametrosAtualizadosPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("parametros_acesso")
}

// Configurações de recursos e catálogo de justificativas. A linha de
// configurações é única, criada na migração; as justificativas nascem com os
// códigos padrão e podem ser editadas pela administração.
model Configuracao {
  id                String                    @id @default("principal")
  frequenciaPorAula Boolean                   @default(false) @map("frequencia_por_aula")
  saidaAntecipada   Boolean                   @default(true) @map("saida_antecipada")
  origemNaChamada   Boolean                   @default(false) @map("origem_na_chamada")
  origemSeries      ConfiguracaoOrigemSerie[]
  origemTurmas      ConfiguracaoOrigemTurma[]
  atualizadoEm      DateTime                  @updatedAt @map("atualizado_em") @db.Timestamptz
  atualizadoPorId   String?                   @map("atualizado_por_id") @db.Uuid
  atualizadoPor     Usuario?                  @relation("ConfiguracaoAtualizadaPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("configuracoes")
}

// Seleções de exibição na Chamada, sem alterar a origem dos alunos.
model ConfiguracaoOrigemSerie {
  configuracaoId String       @map("configuracao_id")
  serieId        String       @map("serie_id") @db.Uuid
  configuracao   Configuracao @relation(fields: [configuracaoId], references: [id], onDelete: Cascade)
  serie          Serie        @relation(fields: [serieId], references: [id], onDelete: Cascade)

  @@id([configuracaoId, serieId])
  @@index([serieId])
  @@map("configuracoes_origem_series")
}

// Turmas específicas somam-se às séries selecionadas na configuração.
model ConfiguracaoOrigemTurma {
  configuracaoId String       @map("configuracao_id")
  turmaId        String       @map("turma_id") @db.Uuid
  configuracao   Configuracao @relation(fields: [configuracaoId], references: [id], onDelete: Cascade)
  turma          Turma        @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([configuracaoId, turmaId])
  @@index([turmaId])
  @@map("configuracoes_origem_turmas")
}

// Catálogo de justificativas de falta e de saída. O código é estável, porque
// a chamada e a saída guardam o código; rótulo e situação são editáveis.
model Justificativa {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo   String   @db.VarChar(10)
  rotulo   String   @db.VarChar(60)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz

  @@map("justificativas")
}

// Catálogo de quem pode liberar a saída antecipada. O código é estável, porque
// a saída guarda o código; rótulo e situação são editáveis na Gestão.
model Liberador {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo   String   @db.VarChar(20)
  rotulo   String   @db.VarChar(60)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz

  @@map("liberadores")
}

// Trilha de auditoria de ações administrativas. Apenas identificadores
// e nomes de ação: nenhum dado pessoal de aluno é registrado.
model Auditoria {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String?  @map("usuario_id") @db.Uuid
  acao      String
  alvo      String
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([criadoEm])
  @@index([usuarioId])
  @@map("auditoria")
}

// Integração com Google Planilhas por conta autorizada. Uma linha por finalidade,
// com a credencial OAuth cifrada no servidor e fora da cópia JSON.
model IntegracaoPlanilha {
  id                 String               @id @default("principal")
  finalidade         FinalidadeIntegracao @default(FREQUENCIA)
  ativa              Boolean              @default(false)
  // Autorização OAuth da frequência, cifrada com AUTH_SECRET no servidor.
  googleRefreshToken String?              @map("google_refresh_token") @db.Text
  googlePlanilhaId   String?              @map("google_planilha_id") @db.VarChar(200)
  googlePlanilhaNome String?              @map("google_planilha_nome") @db.VarChar(200)
  esquema            Json?
  assinaturaEsquema  String?              @map("assinatura_esquema") @db.VarChar(64)
  esquemaEm          DateTime?            @map("esquema_em") @db.Timestamptz
  modo               ModoPlanilha         @default(CONSERVADOR)
  modoCompletoAte    DateTime?            @map("modo_completo_ate") @db.Timestamptz
  // Envia a chamada à planilha logo depois de salva; só a frequência usa.
  envioAutomatico    Boolean              @default(false) @map("envio_automatico")
  modoCompletoPorId  String?              @map("modo_completo_por_id") @db.Uuid
  atualizadoEm       DateTime             @updatedAt @map("atualizado_em") @db.Timestamptz
  atualizadoPorId    String?              @map("atualizado_por_id") @db.Uuid
  modoCompletoPor    Usuario?             @relation("IntegracaoModoPor", fields: [modoCompletoPorId], references: [id], onDelete: SetNull)
  atualizadoPor      Usuario?             @relation("IntegracaoAtualizadaPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("integracoes_planilha")
}

// Histórico de sincronizações, uma linha por envio registrado. Serve ao
// cálculo de dias pendentes e à prestação de contas, sem nomes.
model SincronizacaoPlanilha {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  finalidade       FinalidadeIntegracao    @default(FREQUENCIA)
  turmaOriginalId  String?                 @map("turma_original_id") @db.Uuid
  de               DateTime                @db.Date
  ate              DateTime                @db.Date
  modalidade       ModalidadeSincronizacao
  preenchidas      Int                     @default(0)
  substituidas     Int                     @default(0)
  limpas           Int                     @default(0)
  removidasLinhas  Int                     @default(0) @map("removidas_linhas")
  removidasColunas Int                     @default(0) @map("removidas_colunas")
  alunosCriados    Int                     @default(0) @map("alunos_criados")
  linhasCriadas    Int                     @default(0) @map("linhas_criadas")
  colunasCriadas   Int                     @default(0) @map("colunas_criadas")
  puladasOcupadas  Int                     @default(0) @map("puladas_ocupadas")
  puladasFormula   Int                     @default(0) @map("puladas_formula")
  planoHash        String                  @map("plano_hash") @db.VarChar(64)
  resultado        ResultadoSincronizacao
  erro             String?                 @db.VarChar(300)
  autorId          String?                 @map("autor_id") @db.Uuid
  criadoEm         DateTime                @default(now()) @map("criado_em") @db.Timestamptz
  turmaOriginal    Turma?                  @relation("SincronizacaoTurma", fields: [turmaOriginalId], references: [id], onDelete: SetNull)
  autor            Usuario?                @relation("SincronizacaoCriadaPor", fields: [autorId], references: [id], onDelete: SetNull)

  @@index([turmaOriginalId, criadoEm])
  @@index([criadoEm])
  @@index([finalidade, criadoEm])
  @@map("sincronizacoes_planilha")
}
