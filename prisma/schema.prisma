// Esquema do banco, fonte da verdade do Prisma Client. A frequência é única
// por turma e dia, compartilhada pela coordenação, e cada falta guarda a aula.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Papel do usuário. ADMIN cuida de contas e cadastros; COORDENACAO faz a
// frequência, consulta o histórico e a grade do mês.
enum Papel {
  ADMIN
  COORDENACAO

  @@map("papel")
}

// Modo de escrita na planilha: conservador preenche apenas célula vazia;
// completo permite substituir, limpar e remover o que a integração criou.
enum ModoPlanilha {
  CONSERVADOR
  COMPLETO

  @@map("modo_planilha")
}

// Modalidade registrada em cada sincronização concluída.
enum ModalidadeSincronizacao {
  CONSERVADOR
  COMPLETO

  @@map("modalidade_sincronizacao")
}

// Resultado de uma sincronização: total, parcial ou falha.
enum ResultadoSincronizacao {
  SUCESSO
  PARCIAL
  FALHA

  @@map("resultado_sincronizacao")
}

// Usuário da aplicação. Sem dados além do necessário: nome de
// tratamento, e-mail para acesso, hash da senha e papel.
model Usuario {
  id                       String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                    String
  senhaHash                String                  @map("senha_hash")
  nome                     String
  papel                    Papel                   @default(COORDENACAO)
  ativo                    Boolean                 @default(true)
  criadoEm                 DateTime                @default(now()) @map("criado_em") @db.Timestamptz
  atualizadoEm             DateTime                @updatedAt @map("atualizado_em") @db.Timestamptz
  sessoes                  Sessao[]
  frequenciasCriadas       Frequencia[]            @relation("FrequenciaCriadaPor")
  frequenciasAtualizadas   Frequencia[]            @relation("FrequenciaAtualizadaPor")
  saidasLiberadas          SaidaAntecipada[]       @relation("SaidaLiberadaPor")
  saidasCriadas            SaidaAntecipada[]       @relation("SaidaCriadaPor")
  configuracoesAtualizadas Configuracao[]          @relation("ConfiguracaoAtualizadaPor")
  integracoesModo          IntegracaoPlanilha[]    @relation("IntegracaoModoPor")
  integracoesAtualizadas   IntegracaoPlanilha[]    @relation("IntegracaoAtualizadaPor")
  sincronizacoesPlanilha   SincronizacaoPlanilha[] @relation("SincronizacaoCriadaPor")
  auditorias               Auditoria[]

  @@index([papel])
  @@map("usuarios")
}

// Sessão opaca: o token trafega em cookie HttpOnly apenas como hash.
model Sessao {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  usuarioId String   @map("usuario_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  expiraEm  DateTime @map("expira_em") @db.Timestamptz
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
  @@map("sessoes")
}

// Série escolar (por exemplo, "1º ano"). Referência para as turmas.
model Serie {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome     String
  ordem    Int
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz
  turmas   Turma[]

  @@index([ordem])
  @@map("series")
}

// Turma de uma série (por exemplo, "1º ano A"). A exclusão é barrada
// enquanto houver alunos ou frequências vinculadas.
model Turma {
  id             String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serieId        String                  @map("serie_id") @db.Uuid
  nome           String
  criadoEm       DateTime                @default(now()) @map("criado_em") @db.Timestamptz
  serie          Serie                   @relation(fields: [serieId], references: [id], onDelete: Restrict)
  alunos         Aluno[]                 @relation("AlunoTurma")
  origemDe       Aluno[]                 @relation("AlunoTurmaOriginal")
  frequencias    Frequencia[]
  horarios       Horario[]
  sincronizacoes SincronizacaoPlanilha[] @relation("SincronizacaoTurma")

  @@unique([serieId, nome])
  @@map("turmas")
}

// Aluno de uma turma. Nome do aluno, turma atual (de onde parte a
// frequência diária) e turma original (referência de origem para a
// consulta agrupada). Nenhum outro dado pessoal é armazenado.
model Aluno {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turmaId         String            @map("turma_id") @db.Uuid
  turmaOriginalId String            @map("turma_original_id") @db.Uuid
  nome            String
  ordem           Int
  ativo           Boolean           @default(true)
  criadoEm        DateTime          @default(now()) @map("criado_em") @db.Timestamptz
  turma           Turma             @relation("AlunoTurma", fields: [turmaId], references: [id], onDelete: Restrict)
  turmaOriginal   Turma             @relation("AlunoTurmaOriginal", fields: [turmaOriginalId], references: [id], onDelete: Restrict)
  faltas          Falta[]
  saidas          SaidaAntecipada[]

  @@index([turmaId, ordem])
  @@index([turmaOriginalId])
  @@map("alunos")
}

// Aula da turma: ordem, janela de horário e dias da semana em que acontece.
// A aula padrão cobre o dia inteiro para nenhuma turma ficar sem chamada.
model Horario {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turmaId    String   @map("turma_id") @db.Uuid
  ordem      Int
  inicio     String   @db.VarChar(5)
  fim        String   @db.VarChar(5)
  diasSemana Int[]    @map("dias_semana")
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz
  turma      Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  faltas     Falta[]

  @@unique([turmaId, ordem])
  @@index([turmaId])
  @@map("horarios")
}

// Frequência de um dia e turma, compartilhada pela coordenação. revisao 1 no
// primeiro salvamento e crescimento a cada atualização bem-sucedida; a autoria
// fica anulável para o histórico não depender da conta.
model Frequencia {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turmaId         String   @map("turma_id") @db.Uuid
  dia             DateTime @db.Date
  revisao         Int      @default(1)
  criadoPorId     String?  @map("criado_por_id") @db.Uuid
  atualizadoPorId String?  @map("atualizado_por_id") @db.Uuid
  atualizadoEm    DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  turma           Turma    @relation(fields: [turmaId], references: [id], onDelete: Restrict)
  criadoPor       Usuario? @relation("FrequenciaCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  atualizadoPor   Usuario? @relation("FrequenciaAtualizadaPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)
  faltas          Falta[]

  @@unique([turmaId, dia])
  @@index([dia])
  @@map("frequencias")
}

// Falta de um aluno em uma aula da frequência. Presença não gera linha. A
// justificativa é o código do catálogo e vale para a falta e para a saída.
model Falta {
  frequenciaId  String     @map("frequencia_id") @db.Uuid
  alunoId       String     @map("aluno_id") @db.Uuid
  horarioId     String     @map("horario_id") @db.Uuid
  justificativa String?    @db.VarChar(10)
  observacao    String?    @db.VarChar(200)
  frequencia    Frequencia @relation(fields: [frequenciaId], references: [id], onDelete: Cascade)
  aluno         Aluno      @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  horario       Horario    @relation(fields: [horarioId], references: [id], onDelete: Restrict)

  @@id([frequenciaId, alunoId, horarioId])
  @@index([alunoId])
  @@index([horarioId])
  @@map("faltas")
}

// Saída antecipada registrada pela direção ou coordenação. É separada da
// chamada: a presença ou falta do dia permanece como foi marcada.
model SaidaAntecipada {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alunoId       String   @map("aluno_id") @db.Uuid
  dia           DateTime @db.Date
  momento       String   @db.VarChar(20)
  justificativa String   @db.VarChar(10)
  observacao    String?  @db.VarChar(200)
  liberadoPorId String?  @map("liberado_por_id") @db.Uuid
  criadoPorId   String?  @map("criado_por_id") @db.Uuid
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz
  aluno         Aluno    @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  liberadoPor   Usuario? @relation("SaidaLiberadaPor", fields: [liberadoPorId], references: [id], onDelete: SetNull)
  criadoPor     Usuario? @relation("SaidaCriadaPor", fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@unique([alunoId, dia])
  @@index([dia])
  @@index([alunoId, dia])
  @@map("saidas_antecipadas")
}

// Configurações de recursos e catálogo de justificativas. A linha de
// configurações é única, criada na migração; as justificativas nascem com os
// códigos padrão e podem ser editadas pela administração.
model Configuracao {
  id                String   @id @default("principal")
  frequenciaPorAula Boolean  @default(false) @map("frequencia_por_aula")
  saidaAntecipada   Boolean  @default(true) @map("saida_antecipada")
  atualizadoEm      DateTime @updatedAt @map("atualizado_em") @db.Timestamptz
  atualizadoPorId   String?  @map("atualizado_por_id") @db.Uuid
  atualizadoPor     Usuario? @relation("ConfiguracaoAtualizadaPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("configuracoes")
}

// Catálogo de justificativas de falta e de saída. O código é estável, porque
// a chamada e a saída guardam o código; rótulo e situação são editáveis.
model Justificativa {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo   String   @db.VarChar(10)
  rotulo   String   @db.VarChar(60)
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz

  @@map("justificativas")
}

// Trilha de auditoria de ações administrativas. Apenas identificadores
// e nomes de ação: nenhum dado pessoal de aluno é registrado.
model Auditoria {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String?  @map("usuario_id") @db.Uuid
  acao      String
  alvo      String
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([criadoEm])
  @@index([usuarioId])
  @@map("auditoria")
}

// Integração opcional com Google Planilhas via Apps Script. Linha única: o
// endpoint e o token nunca saem para o cliente e ficam fora da cópia JSON.
model IntegracaoPlanilha {
  id                String       @id @default("principal")
  ativa             Boolean      @default(false)
  endpoint          String?      @db.VarChar(500)
  token             String?      @db.VarChar(120)
  versaoScript      String?      @map("versao_script") @db.VarChar(20)
  esquema           Json?
  assinaturaEsquema String?      @map("assinatura_esquema") @db.VarChar(64)
  esquemaEm         DateTime?    @map("esquema_em") @db.Timestamptz
  modo              ModoPlanilha @default(CONSERVADOR)
  modoCompletoAte   DateTime?    @map("modo_completo_ate") @db.Timestamptz
  modoCompletoPorId String?      @map("modo_completo_por_id") @db.Uuid
  atualizadoEm      DateTime     @updatedAt @map("atualizado_em") @db.Timestamptz
  atualizadoPorId   String?      @map("atualizado_por_id") @db.Uuid
  modoCompletoPor   Usuario?     @relation("IntegracaoModoPor", fields: [modoCompletoPorId], references: [id], onDelete: SetNull)
  atualizadoPor     Usuario?     @relation("IntegracaoAtualizadaPor", fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("integracoes_planilha")
}

// Histórico de sincronizações, uma linha por turma de origem enviada.
// Serve ao cálculo de dias pendentes e à prestação de contas, sem nomes.
model SincronizacaoPlanilha {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turmaOriginalId  String?                 @map("turma_original_id") @db.Uuid
  de               DateTime                @db.Date
  ate              DateTime                @db.Date
  modalidade       ModalidadeSincronizacao
  preenchidas      Int                     @default(0)
  substituidas     Int                     @default(0)
  limpas           Int                     @default(0)
  removidasLinhas  Int                     @default(0) @map("removidas_linhas")
  removidasColunas Int                     @default(0) @map("removidas_colunas")
  alunosCriados    Int                     @default(0) @map("alunos_criados")
  colunasCriadas   Int                     @default(0) @map("colunas_criadas")
  puladasOcupadas  Int                     @default(0) @map("puladas_ocupadas")
  puladasFormula   Int                     @default(0) @map("puladas_formula")
  planoHash        String                  @map("plano_hash") @db.VarChar(64)
  resultado        ResultadoSincronizacao
  erro             String?                 @db.VarChar(300)
  autorId          String?                 @map("autor_id") @db.Uuid
  criadoEm         DateTime                @default(now()) @map("criado_em") @db.Timestamptz
  turmaOriginal    Turma?                  @relation("SincronizacaoTurma", fields: [turmaOriginalId], references: [id], onDelete: SetNull)
  autor            Usuario?                @relation("SincronizacaoCriadaPor", fields: [autorId], references: [id], onDelete: SetNull)

  @@index([turmaOriginalId, criadoEm])
  @@index([criadoEm])
  @@map("sincronizacoes_planilha")
}
