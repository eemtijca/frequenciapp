{
  "name": "frequenciapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "Registro de frequência escolar para professores, mobile-first.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/assets/copiar-swagger-ui.mjs && next dev -p 3000",
    "build": "node scripts/assets/copiar-swagger-ui.mjs && next build",
    "build:worker": "node scripts/build-worker.mjs",
    "vercel-build": "prisma generate && pnpm run build",
    "start": "next start -p 3000",
    "worker": "node dist/worker.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.api.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:componentes": "vitest run --config tests/componentes/vitest.config.ts && playwright test --config=playwright.graficos-visibilidade.config.ts",
    "test:graficos-visibilidade": "playwright test --config=playwright.graficos-visibilidade.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:servidor": "bash tests/servidor/executar.sh",
    "test:servidor:controlador": "node --test tests/servidor/controlador/*.test.mjs && bash tests/servidor/perfis.sh",
    "test:servidor:rapido": "bash tests/servidor/atualizacao.sh",
    "test:instalador:unit": "node --test tests/instalador/*.test.mjs",
    "test:instalador:matriz": "node --test tests/instalador/matriz.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "capturas:readme": "CAPTURAS=1 playwright test tests/ponta-a-ponta/interface/imagens.spec.ts --project=chromium --project=mobile-chrome",
    "capturas:galeria": "CAPTURAS=1 playwright test tests/ponta-a-ponta/interface/galeria.spec.ts --project=chromium --project=mobile-chrome && node scripts/assets/gerar-galeria.mjs && pnpm exec prettier --write docs/imagens/README.md",
    "capturas:readme:docker": "CAPTURAS=1 bash tests/playwright-container.sh tests/ponta-a-ponta/interface/imagens.spec.ts --project=chromium --project=mobile-chrome",
    "test:e2e:docker": "bash tests/playwright-container.sh",
    "test:e2e:docker:chromium": "bash tests/playwright-container.sh --project=chromium",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts",
    "test:pwa:docker": "bash tests/playwright-container.sh --config=playwright.pwa.config.ts --project=chromium",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "criar-admin": "node scripts/administracao/criar-admin.mjs",
    "criar-coordenacao": "node scripts/administracao/criar-coordenacao.mjs",
    "seed": "node scripts/seed/seed.mjs",
    "seed:limpar": "SEED_LIMPAR=true SEED_APENAS_LIMPAR=true node scripts/seed/seed.mjs",
    "etiquetas:sync": "node scripts/github/sincronizar-etiquetas.mjs",
    "icones:gerar": "node scripts/assets/gerar-icones.mjs",
    "rotas:gerar": "node scripts/gerar-rotas-metrica.mjs",
    "lint:api": "redocly lint docs/openapi.json",
    "infra:fmt": "terraform fmt -recursive infra/terraform",
    "infra:validar": "bash infra/terraform/validar.sh",
    "infra:floci": "bash infra/floci/testar.sh",
    "infra:floci:aws": "bash infra/floci/testar.sh aws",
    "infra:floci:azure": "bash infra/floci/testar.sh azure",
    "infra:floci:gcp": "bash infra/floci/testar.sh gcp",
    "servidor:validar": "bash infra/servidor/validar.sh",
    "postinstall": "prisma generate && node scripts/assets/copiar-swagger-ui.mjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^7.0.6",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@mui/x-charts": "9.18.1",
    "@mui/x-date-pickers": "9.18.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prometheus-io/client": "^0.16.1",
    "@zip.js/zip.js": "^2.25.0",
    "bullmq": "^6.7.10",
    "dayjs": "1.11.23",
    "dotenv": "^18.0.10",
    "ioredis": "^6.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "1.9.4",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@redocly/cli": "^2.79.0",
    "@types/leaflet": "^1.9.23",
    "@types/node": "^26",
    "@types/pg": "^8.15.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "prettier": "^3.10.1",
    "sharp": "0.35.5",
    "swagger-ui-dist": "^5.35.0",
    "typescript": "^6",
    "vercel": "65.16.0",
    "vitest": "^5.1.0"
  }
}
