{
  "name": "frequenciapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "Registro de frequência escolar para professores, mobile-first.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/copiar-swagger-ui.mjs && next dev -p 3000",
    "build": "node scripts/copiar-swagger-ui.mjs && next build",
    "vercel-build": "prisma generate && pnpm run build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tsc": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.api.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "capturas:readme": "CAPTURAS=1 playwright test tests/e2e/imagens.spec.ts --project=chromium --project=mobile-chrome",
    "capturas:readme:docker": "CAPTURAS=1 bash tests/playwright-container.sh tests/e2e/imagens.spec.ts --project=chromium --project=mobile-chrome",
    "test:e2e:docker": "bash tests/playwright-container.sh",
    "test:e2e:docker:chromium": "bash tests/playwright-container.sh --project=chromium",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts",
    "test:pwa:docker": "bash tests/playwright-container.sh --config=playwright.pwa.config.ts --project=chromium",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "criar-admin": "node scripts/criar-admin.mjs",
    "criar-coordenacao": "node scripts/criar-coordenacao.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:limpar": "SEED_LIMPAR=true SEED_APENAS_LIMPAR=true node scripts/seed.mjs",
    "etiquetas:sync": "node scripts/sincronizar-etiquetas.mjs",
    "lint:api": "redocly lint docs/openapi.json",
    "infra:fmt": "terraform fmt -recursive infra/terraform",
    "infra:validar": "bash infra/terraform/validar.sh",
    "infra:floci": "bash infra/floci/testar.sh",
    "infra:floci:aws": "bash infra/floci/testar.sh aws",
    "infra:floci:azure": "bash infra/floci/testar.sh azure",
    "infra:floci:gcp": "bash infra/floci/testar.sh gcp",
    "postinstall": "prisma generate && node scripts/copiar-swagger-ui.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@zip.js/zip.js": "^2.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.577.0",
    "motion": "^13.5.1",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@redocly/cli": "^2.62.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.15.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "swagger-ui-dist": "^5.33.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.3",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
